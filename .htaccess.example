# Copy to .htaccess (git-ignored). Works as-is in any directory under the DocumentRoot.

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Needed only if this directory is reached through an Alias: set it to the URL path,
    # e.g. RewriteBase /api/teams/
    # RewriteBase /

    # Block direct access to application internals.
    RewriteRule ^(?:src|bin|database)(?:/|$)          - [F,L]
    RewriteRule ^config(?:\.example)?\.php$           - [F,L]
    RewriteRule \.(?:sqlite|sqlite-wal|sqlite-shm|md)$ - [F,L]

    # Serve real static files (logos) directly.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Everything else goes through the front controller.
    RewriteRule ^ index.php [L]
</IfModule>

# --- Optional: Shibboleth SSO for the admin UI (with 'auth' => 'shibboleth' in config.php) ---
# Requires mod_shib and a configured Shibboleth SP. Asks for a login on any .../admin URL;
# the API, logos and /docs stay public. Who gets in is 'shib_admins' in config.php (the app
# refuses anyone else, and anyone at all if no SSO user reaches it). Matched on THE_REQUEST
# (the original request line) because the rewrite to index.php re-runs access checks with
# REQUEST_URI = .../index.php.
#
# <If "%{THE_REQUEST} =~ m#^[A-Z]+ [^? ]*/admin(?:[/? ]|$)#">
#     AuthType shibboleth
#     ShibRequestSetting requireSession 1
#     Require shib-session
# </If>

# Logos are fetched cross-origin by the consumer apps (e.g. drawn onto a <canvas>).
<IfModule mod_headers.c>
    <FilesMatch "\.(png|jpe?g|gif|webp|svg)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>

# Belt-and-suspenders for hosts that honour <Files> but not the rules above.
<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|md)$">
    Require all denied
</FilesMatch>
